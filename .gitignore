*~
dotfiles/dot-config/tmux/plugins
.DS_Store
dotfiles/dot-config/go
.env
.env.local
logs
swiftpm
dotfiles/dot-config/menus/applications-merged.mcp.json
dotfiles/dot-config/menus/
dotfiles/dot-config/karabiner/automatic_backups

# Skills - ignore all, then whitelist published ones
dotfiles/dot-claude/skills/**
!dotfiles/dot-claude/skills/claude-expert/
!dotfiles/dot-claude/skills/claude-expert/**
!dotfiles/dot-claude/skills/self-healing/
!dotfiles/dot-claude/skills/self-healing/**
!dotfiles/dot-claude/skills/roast-me/
!dotfiles/dot-claude/skills/roast-me/**
!dotfiles/dot-claude/skills/learning/
!dotfiles/dot-claude/skills/learning/**
!dotfiles/dot-claude/skills/minecraft-client-expert/
!dotfiles/dot-claude/skills/minecraft-client-expert/**
!dotfiles/dot-claude/skills/grill-me/
!dotfiles/dot-claude/skills/grill-me/**
!dotfiles/dot-claude/skills/gitnexus-cli/
!dotfiles/dot-claude/skills/gitnexus-cli/**
!dotfiles/dot-claude/skills/gitnexus-guide/
!dotfiles/dot-claude/skills/gitnexus-guide/**
dotfiles/dot-claude/skills/learning/.env
dotfiles/dot-config/cagent/.cagent_first_run

# Jira CLI - generated from template + .env
dotfiles/dot-config/.jira/.config.yml

# git config include with a professional identity (name + work email) -
# machine-local, never committed to this public repo
dotfiles/dot-config/git/config-key*

# rclone - OAuth tokens and machine-local config
dotfiles/dot-config/rclone/rclone.conf
# rclone's own atomic-write temp files (pattern rclone.conf<random>), left behind
# on an interrupted config rewrite - never intentional, never committed
dotfiles/dot-config/rclone/rclone.conf[0-9]*

# glab CLI - recovery data may contain professional info
dotfiles/dot-config/glab-cli/recover/

# Docker - runtime state
dotfiles/dot-config/docker/buildx/
dotfiles/dot-config/docker/.token_seed
dotfiles/dot-config/docker/.token_seed.lock

# Homebrew - machine-local trust store (the list of trusted third-party taps and
# its lock; created in ~/.config/homebrew because XDG_CONFIG_HOME=~/.config, which
# is stow-symlinked into this repo). Trust is an explicit per-machine decision
# (run `brew trust --formula <owner>/<tap>/<name>`), never seeded from the repo.
dotfiles/dot-config/homebrew/trust.json
dotfiles/dot-config/homebrew/trust.json.lock

# gitleaks - private forbidden-terms list (company/project names kept out of
# this public repo). The .example template IS committed; the real file is not.
.forbidden-terms.toml

# GitNexus - machine-local repo paths (private). The .example is committed.
scripts/setup-gitnexus.local

# OpenSpec working directory - change proposals routinely mix planning
# artifacts with personal/professional content (this is a PUBLIC repo):
# keep the whole tree local only
openspec/

# Python bytecode
__pycache__/
*.pyc
